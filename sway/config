# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  sway config — keyboard tiling + full mouse control                      ║
# ║                                                                          ║
# ║  Install to:  ~/.config/sway/config                                      ║
# ║  Reload with: Super+Shift+c        Check with: sway -C                   ║
# ║  Docs:        man 5 sway, man 5 sway-input, man 5 sway-bar               ║
# ║                                                                          ║
# ║  Optional helpers (each binding just does nothing if one is missing):    ║
# ║    foot            terminal            fuzzel/wofi/rofi  app launcher    ║
# ║    swaylock        screen locker       swayidle          idle handling   ║
# ║    grim + slurp    screenshots         wl-clipboard      clipboard       ║
# ║    wpctl           volume (PipeWire)   brightnessctl     backlight       ║
# ║    playerctl       media keys          mako              notifications   ║
# ╚══════════════════════════════════════════════════════════════════════════╝


# ── 1. Variables ─────────────────────────────────────────────────────────────

set $mod   Mod4
set $alt   Mod1

# Vim-style direction keys (the arrow keys work everywhere too)
set $left  h
set $down  j
set $up    k
set $right l

set $term  foot

# First launcher that is installed wins
set $menu  sh -c 'for c in fuzzel "wofi --show drun" "rofi -show drun" wmenu-run bemenu-run; do command -v ${c%% *} >/dev/null && exec $c; done'

set $lock  swaylock -f -c 1a1b26

# Workspaces
set $ws1  1
set $ws2  2
set $ws3  3
set $ws4  4
set $ws5  5
set $ws6  6
set $ws7  7
set $ws8  8
set $ws9  9
set $ws10 10

# Palette (Tokyo Night)
set $bg      #1a1b26
set $bg_alt  #24283b
set $fg      #c0caf5
set $muted   #565f89
set $blue    #7aa2f7
set $cyan    #7dcfff
set $purple  #bb9af7
set $green   #9ece6a
set $yellow  #e0af68
set $red     #f7768e


# ── 2. Outputs and inputs ────────────────────────────────────────────────────

# Solid background; swap for an image with:  output * bg ~/Pictures/wall.png fill
output * bg $bg solid_color

# List your outputs with `swaymsg -t get_outputs`, then for example:
#   output eDP-1    resolution 1920x1080 position 0,0    scale 1
#   output HDMI-A-1 resolution 2560x1440 position 1920,0

input type:keyboard {
    repeat_delay 250
    repeat_rate  40
    # xkb_layout  us,is
    # xkb_options grp:alt_shift_toggle,caps:escape
}

input type:touchpad {
    tap             enabled
    tap_button_map  lrm
    drag            enabled
    natural_scroll  enabled
    dwt             enabled
    middle_emulation enabled
    scroll_method   two_finger
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

# Hide the pointer after 8 s of inactivity and while typing
seat * hide_cursor 8000
seat * hide_cursor when-typing enable


# ── 3. Look and feel ─────────────────────────────────────────────────────────

font pango:monospace 10

# Title bars are kept on purpose: they are the mouse handles for dragging,
# tab switching and the click actions in section 5. Super+t toggles them.
default_border          normal 2
default_floating_border normal 2
titlebar_border_thickness 2
titlebar_padding 8 4
title_align center

gaps inner 8
gaps outer 2
smart_gaps    on
smart_borders on

# class                 border   backgr.  text    indicator child_border
client.focused          $blue    $blue    $bg     $cyan     $blue
client.focused_inactive $bg_alt  $bg_alt  $fg     $bg_alt   $bg_alt
client.unfocused        $bg      $bg      $muted  $bg       $bg
client.urgent           $red     $red     $bg     $red      $red
client.placeholder      $bg      $bg      $fg     $bg       $bg
client.background       $bg


# ── 4. Tiling behaviour ──────────────────────────────────────────────────────

workspace_layout default
workspace_auto_back_and_forth yes
focus_wrapping no
focus_on_window_activation smart
popup_during_fullscreen smart

floating_minimum_size 200 x 120
floating_maximum_size 2560 x 1440


# ── 5. Mouse ─────────────────────────────────────────────────────────────────
#
#   Hover a window ............................. focus it
#   Drag a title bar ........................... move it; drop on another
#                                                window's edge to re-tile there
#   Drag the border between two windows ........ resize them
#   Super + left-drag  (anywhere in a window) .. move  (tiled or floating)
#   Super + right-drag (anywhere in a window) .. resize
#   Scroll on a tab/stack title bar ............ cycle tabs
#   Middle-click title bar ..................... close window
#   Right-click title bar ...................... toggle floating
#   Super + middle-click ....................... close window
#   Super + scroll ............................. previous / next workspace
#   Super + Shift + scroll ..................... window opacity
#   Super + Ctrl  + scroll ..................... grow / shrink window
#   Super + side buttons ....................... floating / fullscreen
#   Scroll on the bar .......................... previous / next workspace
#   Right-click the bar ........................ app launcher

focus_follows_mouse yes
mouse_warping container

floating_modifier $mod normal
tiling_drag enable
tiling_drag_threshold 12

# Title bar clicks
bindsym button2 kill
bindsym button3 floating toggle

# Super + mouse, anywhere over a window
bindsym --whole-window $mod+button2 kill
bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+Shift+button4 opacity plus  0.05
bindsym --whole-window $mod+Shift+button5 opacity minus 0.05
bindsym --whole-window $mod+Ctrl+button4 resize grow   width 30px
bindsym --whole-window $mod+Ctrl+button5 resize shrink width 30px
bindsym --whole-window $mod+button8 floating toggle
bindsym --whole-window $mod+button9 fullscreen toggle

# Touchpad gestures
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left  workspace next_on_output
bindgesture swipe:3:up    fullscreen toggle
bindgesture swipe:3:down  floating toggle
bindgesture swipe:4:down  move scratchpad
bindgesture swipe:4:up    scratchpad show


# ── 6. Keys: basics ──────────────────────────────────────────────────────────

bindsym $mod+Return   exec $term
bindsym $mod+d        exec $menu
bindsym $mod+Shift+q  kill
bindsym $mod+Shift+c  reload
bindsym $mod+Escape   exec $lock


# ── 7. Keys: focus and move ──────────────────────────────────────────────────

bindsym $mod+$left   focus left
bindsym $mod+$down   focus down
bindsym $mod+$up     focus up
bindsym $mod+$right  focus right
bindsym $mod+Left    focus left
bindsym $mod+Down    focus down
bindsym $mod+Up      focus up
bindsym $mod+Right   focus right

bindsym $mod+Shift+$left   move left
bindsym $mod+Shift+$down   move down
bindsym $mod+Shift+$up     move up
bindsym $mod+Shift+$right  move right
bindsym $mod+Shift+Left    move left
bindsym $mod+Shift+Down    move down
bindsym $mod+Shift+Up      move up
bindsym $mod+Shift+Right   move right

# Resize without entering a mode
bindsym $mod+Ctrl+$left   resize shrink width  40px
bindsym $mod+Ctrl+$down   resize grow   height 40px
bindsym $mod+Ctrl+$up     resize shrink height 40px
bindsym $mod+Ctrl+$right  resize grow   width  40px
bindsym $mod+Ctrl+Left    resize shrink width  40px
bindsym $mod+Ctrl+Down    resize grow   height 40px
bindsym $mod+Ctrl+Up      resize shrink height 40px
bindsym $mod+Ctrl+Right   resize grow   width  40px

bindsym $mod+a      focus parent
bindsym $mod+z      focus child
bindsym $mod+space  focus mode_toggle
bindsym $alt+Tab    focus next
bindsym $alt+Shift+Tab focus prev


# ── 8. Keys: layouts ─────────────────────────────────────────────────────────

# Where the next window goes
bindsym $mod+b  splith
bindsym $mod+v  splitv
bindsym $mod+n  split none

# How the current container is arranged
bindsym $mod+e  layout toggle split
bindsym $mod+s  layout stacking
bindsym $mod+w  layout tabbed
bindsym $mod+o  layout toggle all

bindsym $mod+f            fullscreen toggle
bindsym $mod+Shift+f      fullscreen toggle global
bindsym $mod+Shift+space  floating toggle
bindsym $mod+Shift+s      sticky toggle
bindsym $mod+t            border toggle
bindsym $mod+c            move position center

# Mark a window, then swap any other window with it
bindsym $mod+m        mark --toggle swap
bindsym $mod+Shift+m  swap container with mark swap

# Scratchpad: a hidden shelf for windows
bindsym $mod+Shift+minus  move scratchpad
bindsym $mod+minus        scratchpad show


# ── 9. Keys: workspaces ──────────────────────────────────────────────────────

bindsym $mod+1  workspace number $ws1
bindsym $mod+2  workspace number $ws2
bindsym $mod+3  workspace number $ws3
bindsym $mod+4  workspace number $ws4
bindsym $mod+5  workspace number $ws5
bindsym $mod+6  workspace number $ws6
bindsym $mod+7  workspace number $ws7
bindsym $mod+8  workspace number $ws8
bindsym $mod+9  workspace number $ws9
bindsym $mod+0  workspace number $ws10

bindsym $mod+Shift+1  move container to workspace number $ws1
bindsym $mod+Shift+2  move container to workspace number $ws2
bindsym $mod+Shift+3  move container to workspace number $ws3
bindsym $mod+Shift+4  move container to workspace number $ws4
bindsym $mod+Shift+5  move container to workspace number $ws5
bindsym $mod+Shift+6  move container to workspace number $ws6
bindsym $mod+Shift+7  move container to workspace number $ws7
bindsym $mod+Shift+8  move container to workspace number $ws8
bindsym $mod+Shift+9  move container to workspace number $ws9
bindsym $mod+Shift+0  move container to workspace number $ws10

bindsym $mod+Tab           workspace back_and_forth
bindsym $mod+bracketleft   workspace prev_on_output
bindsym $mod+bracketright  workspace next_on_output
bindsym $mod+Shift+bracketleft   move container to workspace prev_on_output
bindsym $mod+Shift+bracketright  move container to workspace next_on_output

# Multi-monitor: send the whole workspace to the neighbouring screen
bindsym $mod+Ctrl+Shift+$left   move workspace to output left
bindsym $mod+Ctrl+Shift+$down   move workspace to output down
bindsym $mod+Ctrl+Shift+$up     move workspace to output up
bindsym $mod+Ctrl+Shift+$right  move workspace to output right
bindsym $mod+Ctrl+Shift+Left    move workspace to output left
bindsym $mod+Ctrl+Shift+Down    move workspace to output down
bindsym $mod+Ctrl+Shift+Up      move workspace to output up
bindsym $mod+Ctrl+Shift+Right   move workspace to output right


# ── 10. Modes ────────────────────────────────────────────────────────────────

set $mode_resize "resize: h/j/k/l or arrows · Shift = fine · Esc"
mode $mode_resize {
    bindsym $left   resize shrink width  40px
    bindsym $down   resize grow   height 40px
    bindsym $up     resize shrink height 40px
    bindsym $right  resize grow   width  40px
    bindsym Left    resize shrink width  40px
    bindsym Down    resize grow   height 40px
    bindsym Up      resize shrink height 40px
    bindsym Right   resize grow   width  40px

    bindsym Shift+$left   resize shrink width  5px
    bindsym Shift+$down   resize grow   height 5px
    bindsym Shift+$up     resize shrink height 5px
    bindsym Shift+$right  resize grow   width  5px
    bindsym Shift+Left    resize shrink width  5px
    bindsym Shift+Down    resize grow   height 5px
    bindsym Shift+Up      resize shrink height 5px
    bindsym Shift+Right   resize grow   width  5px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode $mode_resize

set $mode_gaps "gaps: +/- inner · Shift +/- outer · 0 none · d default · Esc"
mode $mode_gaps {
    bindsym plus         gaps inner current plus  4
    bindsym equal        gaps inner current plus  4
    bindsym minus        gaps inner current minus 4
    bindsym Shift+plus   gaps outer current plus  4
    bindsym Shift+equal  gaps outer current plus  4
    bindsym Shift+minus  gaps outer current minus 4
    bindsym Shift+underscore gaps outer current minus 4
    bindsym 0  gaps inner current set 0, gaps outer current set 0
    bindsym d  gaps inner current set 8, gaps outer current set 2

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+g mode $mode_gaps

set $mode_system "system: (l)ock · (e)xit sway · (s)uspend · (r)eboot · (p)oweroff · Esc"
mode $mode_system {
    bindsym l  exec $lock, mode "default"
    bindsym e  exit
    bindsym s  exec systemctl suspend, mode "default"
    bindsym r  exec systemctl reboot
    bindsym p  exec systemctl poweroff

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+e mode $mode_system


# ── 11. Media keys and screenshots ───────────────────────────────────────────

bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay         exec playerctl play-pause
bindsym --locked XF86AudioNext         exec playerctl next
bindsym --locked XF86AudioPrev         exec playerctl previous

# Print: drag a region with the mouse, copied to the clipboard
bindsym Print        exec grim -g "$(slurp)" - | wl-copy
# Ctrl+Print: region saved to ~/Pictures     Shift+Print: whole screen saved
bindsym Ctrl+Print   exec mkdir -p ~/Pictures && grim -g "$(slurp)" ~/Pictures/shot-$(date +%Y%m%d-%H%M%S).png
bindsym Shift+Print  exec mkdir -p ~/Pictures && grim ~/Pictures/shot-$(date +%Y%m%d-%H%M%S).png


# ── 12. Window rules ─────────────────────────────────────────────────────────

# Dialogs and small utility windows float instead of tiling
for_window [window_role="pop-up"]      floating enable
for_window [window_role="dialog"]      floating enable
for_window [window_type="dialog"]      floating enable
for_window [window_type="utility"]     floating enable
for_window [app_id="pavucontrol"]      floating enable, resize set 800 600
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"]  floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [title="^Open File$"]       floating enable
for_window [title="^Save As$"]         floating enable

# Do not let the screen lock while something is fullscreen (video, calls)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"]  inhibit_idle fullscreen

# Mark XWayland windows in their title so they are easy to spot
for_window [shell="xwayland"] title_format "%title  [X11]"


# ── 13. Bar ──────────────────────────────────────────────────────────────────

bar {
    position top
    font pango:monospace 10
    height 26
    workspace_min_width 30
    tray_padding 4

    # Battery (when present) and clock; swap in waybar/i3status if you like
    status_command while echo $(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1 | sed s/$/%/) $(date +'%a %d %b · %H:%M'); do sleep 10; done

    # Mouse on the bar: scrolling switches workspaces (built in)
    bindsym button3 exec $menu

    colors {
        background $bg
        statusline $fg
        separator  $muted

        # class            border   backgr.  text
        focused_workspace  $blue    $blue    $bg
        active_workspace   $bg_alt  $bg_alt  $fg
        inactive_workspace $bg      $bg      $muted
        urgent_workspace   $red     $red     $bg
        binding_mode       $yellow  $yellow  $bg
    }
}


# ── 14. Autostart ────────────────────────────────────────────────────────────

# Lock after 5 min, screen off after 10 min, lock before sleep
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

# Notifications
exec command -v mako >/dev/null && mako

# Optional: split automatically along the longer side of each window
# exec command -v autotiling >/dev/null && autotiling

# Distribution and personal drop-ins
include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
